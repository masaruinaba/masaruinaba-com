{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/museum(?:/(.*))?",
      "has": [
        {
          "type": "host",
          "value": "www.masaruinaba.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://museum.masaruinaba.com/$1"
      }
    },
    {
      "src": "/museum(?:/(.*))?",
      "has": [
        {
          "type": "host",
          "value": "masaruinaba.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://museum.masaruinaba.com/$1"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "museum.masaruinaba.com"
        }
      ],
      "dest": "/museum/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "museum.masaruinaba.com"
        }
      ],
      "dest": "/museum/$1"
    }
  ]
}